# ============================================================
# web-search-server 环境变量配置模板
# 复制此文件为 .env 并填入实际值：cp .env.example .env
# ============================================================

# ===== 服务配置 =====
# 服务监听端口（默认 18923）
SEARCH_SERVER_PORT=18923
# 绑定地址（生产环境建议 127.0.0.1）
SEARCH_SERVER_HOST=0.0.0.0

# ===== API 密钥 =====
# DeepSeek API Key（用于 AI 搜索摘要，可选）
DEEPSEEK_API_KEY=

# ===== 搜索配置 =====
# 默认搜索引擎（google/bing/duckduckgo）
DEFAULT_ENGINE=duckduckgo
# 每次搜索最大结果数
MAX_RESULTS=10
# 请求超时（秒）
REQUEST_TIMEOUT=15
