# ---------------------------------------------------------------------------
# Python 通用忽略规则
# ---------------------------------------------------------------------------

# 字节码缓存与编译产物
__pycache__/
*.py[cod]

# 虚拟环境目录
.venv/
venv/

# 本地环境变量文件（切勿提交密钥等敏感信息）
.env

# 运行日志
*.log

# 测试 / 类型检查 / ruff 缓存目录
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 编辑器配置目录
.idea/
.vscode/

# 打包与构建产物
dist/
build/
*.egg-info/
